# Proposed configuration. These defaults do not trigger remote requests.
ANALYSIS_OCR=1
ANALYSIS_ASR=0
ANALYSIS_JEV=0
ANALYSIS_ONEJEV=0
ANALYSIS_LOCAL_ONLY=1
ANALYSIS_ALLOW_CLOUD_TEXT=0
ANALYSIS_ALLOW_CLOUD_FRAMES=0

# Provision/pin evaluated model weights explicitly before enabled jobs.
ANALYSIS_OCR_LANGUAGES=en
ANALYSIS_MAX_OCR_FRAMES_PER_MINUTE=8
ANALYSIS_MAX_IMAGES_PER_REQUEST=12
ANALYSIS_STATE_MAX_BYTES=16000
ANALYSIS_MAX_QUESTIONS_PER_REQUEST=20

# TYPESAFE_API_KEY is intentionally absent. Presence alone is not consent.
# No model server is bundled or auto-started by this reference pack.
